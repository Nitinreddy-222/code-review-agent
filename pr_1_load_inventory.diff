+import json
+
+def LoadInventoryFile(filePath):
+    f = open(filePath)
+    data = json.load(f)
+    itemCount = len(data["items"])
+    total_value = 0
+    for item in data["items"]:
+        total_value = total_value + item["price"] * item["qty"]
+    return {
+        "itemCount": itemCount,
+        "total_value": total_value
+    }
