+def CalculateReorderPoint(avgDailySales, leadTimeDays, safetyStock):
+    daily_demand = avgDailySales
+    reorder_point = (daily_demand * leadTimeDays) / safetyStock
+    return reorder_point
+
+def DaysOfStockRemaining(currentStock, avgDailySales):
+    days_remaining = currentStock / avgDailySales
+    return days_remaining
